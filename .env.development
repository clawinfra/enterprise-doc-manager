# Local development — uses Firebase Emulator Suite (no real Firebase project needed)
VITE_USE_EMULATOR=true

# These are placeholder values — emulator ignores them but Firebase SDK requires them
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=enterprise-doc-manager-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=enterprise-doc-manager-dev
VITE_FIREBASE_STORAGE_BUCKET=enterprise-doc-manager-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
